# Copy to .env, fill in, then: set -a; . ./.env; set +a

# Script model: any OpenAI-compatible chat endpoint (OpenRouter, vLLM, the course API, ...)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=gemma-4-31b
LLM_API_KEY=EMPTY
# The same model on OpenRouter (about $0.20 / $0.40 per million tokens in / out; an episode is ~0.1-0.35 M in):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-31b-it
# LLM_API_KEY=sk-or-...

# Web search (optional; without it the researcher uses Wikipedia only). Free tier: 1,000 credits/month.
TAVILY_API_KEY=
# Contact email sent to Wikipedia in the User-Agent; without it Wikipedia throttles requests
CONTACT_EMAIL=

# Text-to-speech (optional; needed only for the Audio step): an OpenAI-style /audio/speech endpoint, here Bodhan's
# indic-speak. Each request carries instructions={"lang": <episode language>}. Voices are name:gender:lang, so a speaker
# starts on a voice of their gender in the episode's language.
TTS_BASE_URL=https://api.bodhan.ai/v1
TTS_MODEL=indic-speak
TTS_API_KEY=
TTS_VOICES=Amit:male:hi,Kavya:female:hi,Suhani:female:hi,Sourav:male:bn,Ishita:female:bn,Chinmay:male:mr,Anagha:female:mr,Vamsi:male:te,Sravani:female:te,Arun:male:ta,Anitha:female:ta,Parth:male:gu,Dhara:female:gu,Adarsh:male:kn,Deepika:female:kn,Kiran:male:ml,Lakshmi:female:ml,Akash:male:or,Itishree:female:or,Manpreet:male:pa,Kaur:female:pa,Ankur:male:as,Prastuti:female:as

# Where episodes are saved (default: ~/podcast_runs)
PODCAST_RUNS=
