# Copy to .env, fill in, then: set -a; . ./.env; set +a

# Script model: any OpenAI-compatible chat endpoint (vLLM, the course API, ...)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=gemma-4-31b
LLM_API_KEY=EMPTY

# Web search (optional; without it the researcher uses Wikipedia only). Free tier: 1,000 credits/month.
TAVILY_API_KEY=
# Contact email sent to Wikipedia in the User-Agent; without it Wikipedia throttles requests
CONTACT_EMAIL=

# Text-to-speech (optional; needed only for the Audio step): OpenAI-style /audio/speech endpoint
TTS_BASE_URL=
TTS_MODEL=tts
TTS_API_KEY=EMPTY
TTS_VOICES=

# Where episodes are saved (default: ~/podcast_runs)
PODCAST_RUNS=
